{
  "name": "zhijing-plan-b",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_BASE_PATH=/zhijing WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1 --port 3100",
    "dev:plan-b": "node scripts/plan-b-dev.mjs",
    "build": "NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH:-/zhijing} WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "NEXT_PUBLIC_BASE_PATH=/zhijing WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 127.0.0.1 --port 3100",
    "test": "npm run test:unit && npm run typecheck && npm run lint && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/learning-core.test.mjs tests/learning-api.test.mjs tests/study-content.test.mjs tests/study-render.test.mjs tests/demo-selection.test.mjs",
    "test:plan-b": "node --test tests/plan-b-isolation.test.mjs tests/zhixing.test.mjs",
    "test:acceptance": "node scripts/acceptance.mjs",
    "typecheck": "tsc --noEmit",
    "api": "node server/index.mjs",
    "demo:install": "npm ci --prefix experiments/openmaic-preview --ignore-scripts",
    "demo:build": "node experiments/article-motion/build.mjs && ZH_LESSON=window-five-years npm run build --prefix experiments/openmaic-preview",
    "dev:demo": "NEXT_PUBLIC_BASE_PATH=/zhijing npm run dev",
    "build:complete": "npm run demo:build && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.468.0",
    "motion": "^13.1.1",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
